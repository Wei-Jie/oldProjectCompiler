@echo off
chcp 65001 >nul
echo ====================================================================
echo   訊光 EEP 全系統業務與程式碼導覽地圖產生器 (解決大海撈針問題)
echo   自動掃描所有專案的：畫面標題、Client-Server 呼叫關聯、SQL 資料表
echo ====================================================================
set /p SRC_DIR="請輸入或拖曳公司舊系統的原始碼根目錄 (直接按 Enter 則掃描本工具上層目錄): "
if "%SRC_DIR%"=="" (
    for %%I in ("%~dp0..") do set "SRC_DIR=%%~fI"
)
"%~dp0eepc.exe" index "%SRC_DIR%"
pause
